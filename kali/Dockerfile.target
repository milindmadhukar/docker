FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt update && apt install -y \
    openssh-server \
    sudo \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir /var/run/sshd

RUN echo 'root:root123' | chpasswd

RUN useradd -m -s /bin/bash admin && echo 'admin:admin123' | chpasswd
RUN useradd -m -s /bin/bash user && echo 'user:password123' | chpasswd
RUN useradd -m -s /bin/bash test && echo 'test:test123' | chpasswd
RUN useradd -m -s /bin/bash guest && echo 'guest:guest123' | chpasswd

RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config
RUN sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config

RUN ssh-keygen -A

EXPOSE 22

CMD ["/usr/sbin/sshd", "-D"]